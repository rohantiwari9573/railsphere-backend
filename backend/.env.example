APP_NAME=RailSphere API
APP_VERSION=1.0.0

DEBUG=True

HOST=127.0.0.1
PORT=8000

DATABASE_URL=

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed frontend origins, e.g.
# http://localhost:5173,https://railsphere.example.com
# Leave empty to disable CORS entirely (no cross-origin browser access).
CORS_ORIGINS=

# Redis connection string, e.g. from a free Upstash database:
# rediss://default:<password>@<endpoint>.upstash.io:6379
# Leave empty to run without Redis -- response caching then silently
# no-ops, and the analytics materialized views must be refreshed
# manually (scripts/refresh_analytics_views.py) instead of by the
# scheduled arq worker (app/worker.py).
REDIS_URL=

# Base URL of an OTLP/HTTP trace collector, e.g. Jaeger's docker-compose
# service: http://localhost:4318 (when running the app outside Docker)
# or http://jaeger:4318 (from inside the compose network). Leave empty
# to run without tracing -- no OpenTelemetry instrumentation or
# exporter is set up at all in that case.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Fernet key encrypting User.email at rest. Required -- generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=