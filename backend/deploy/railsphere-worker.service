[Unit]
Description=RailSphere arq background worker (scheduled analytics refresh)
After=network.target
Requires=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/railsphere-backend/backend
Environment=PATH=/home/ubuntu/railsphere-backend/backend/.venv/bin
ExecStart=/home/ubuntu/railsphere-backend/backend/.venv/bin/arq app.worker.WorkerSettings
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
